// v2.6 device menu: every phone ZenLink sees, on the left of the picture.
// The selected phone opens its own sub-menu (Screen settings, Files) and
// each phone can move to a window of its own and back.
import { Theme, I18n } from "theme.slint";
import { Glass, Icon, Tip } from "widgets.slint";

export struct RailDev {
    // "android" | "apple"
    kind: string,
    title: string,
    sub: string,
    // "live" | "ready" | "need" | "off" | "window"
    state: string,
    selected: bool,
    // The sub-menu offers Files (Android only for now).
    files: bool,
    // Can move to a window of its own (a ready Android phone).
    pop: bool,
}

component RailItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    border-radius: 10px;
    background: on ? Theme.accent-soft : ta.has-hover && enabled ? Theme.fill : transparent;
    opacity: enabled ? 1 : 0.45;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Icon { width: 18px; text: root.icon; font-size: 14px; color: root.on ? Theme.accent : Theme.text-2; }
        Text {
            text: root.label;
            font-size: 12.5px;
            color: root.on ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component DeviceRail inherits Glass {
    in property <[RailDev]> devices;
    in property <bool> screen-on;
    in property <bool> files-on;
    callback pick(int);
    callback screen();
    callback files();
    callback pop(int);
    callback connect();
    // HOME: device type and mode choice, shown inside the stage.
    in property <bool> home-on;
    callback home();
    border-radius: 22px;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        alignment: start;
        RailItem {
            icon: "\u{E80F}";
            label: I18n.t("Beranda", "Home");
            on: root.home-on;
            clicked => { root.home(); }
        }
        Rectangle { height: 6px; }
        Text {
            text: I18n.t("Perangkat", "Devices");
            font-size: 11px;
            color: Theme.text-3;
            height: 22px;
            vertical-alignment: center;
        }
        if root.devices.length == 0: Text {
            text: I18n.t("Belum ada perangkat. Colokkan HP atau sambung lewat Wi-Fi.", "No device yet. Plug in a phone or connect over Wi-Fi.");
            font-size: 11.5px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        for d[i] in root.devices: VerticalLayout {
            spacing: 2px;
            Rectangle {
                height: 46px;
                border-radius: 12px;
                background: d.selected ? Theme.accent-soft : ta.has-hover ? Theme.fill : transparent;
                ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(i); } }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 10px;
                    Icon {
                        width: 18px;
                        text: d.kind == "apple" ? "\u{E70A}" : "\u{E8EA}";
                        font-size: 16px;
                        color: d.selected ? Theme.accent : Theme.text-2;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: d.title;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: d.selected ? Theme.accent : Theme.text;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: d.state == "live" ? Theme.accent
                                        : d.state == "ready" || d.state == "window" ? #22c55e
                                        : d.state == "need" ? #f59e0b : Theme.text-3;
                                }
                            }
                        }
                        Text {
                            text: d.state == "window" ? I18n.t("Jendela sendiri", "Own window") : d.sub;
                            font-size: 10.5px;
                            color: Theme.text-3;
                            overflow: elide;
                        }
                    }
                    // Move to a window of its own (like dragging a Chrome tab out).
                    if d.pop: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: pa.has-hover ? Theme.fill : transparent;
                            Icon { text: "\u{E8A7}"; font-size: 12px; color: Theme.text-2; }
                            pa := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Tip.shown = false; root.pop(i); }
                                changed has-hover => {
                                    if self.has-hover {
                                        Tip.text = I18n.t("Pisah ke jendela sendiri", "Move to its own window");
                                        Tip.x = self.absolute-position.x + self.width / 2;
                                        Tip.top = self.absolute-position.y;
                                        Tip.bottom = self.absolute-position.y + self.height;
                                        Tip.shown = true;
                                    } else {
                                        Tip.shown = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Sub-menu of the selected phone.
            if d.selected && d.state != "window": VerticalLayout {
                padding-left: 22px;
                spacing: 2px;
                RailItem {
                    icon: "\u{E7F4}";
                    label: I18n.t("Layar", "Screen");
                    on: root.screen-on;
                    enabled: d.kind == "android";
                    clicked => { root.screen(); }
                }
                RailItem {
                    icon: "\u{E8B7}";
                    label: d.files ? I18n.t("File", "Files") : I18n.t("File · segera", "Files · soon");
                    on: root.files-on;
                    enabled: d.files;
                    clicked => { root.files(); }
                }
            }
        }
        Rectangle { height: 4px; }
        RailItem {
            icon: "\u{E710}";
            label: I18n.t("Sambung perangkat", "Connect a device");
            clicked => { root.connect(); }
        }
    }
}
