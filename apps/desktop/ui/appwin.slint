// One Android app in its own window (v2.5.1): `ZenLink.exe --android-app`.
// The app runs on its own virtual display on the phone (scrcpy new_display);
// the picture is the same native D3D11 child window as the main window's.
// v2.6: frameless glass window like the main one (own header, traffic
// lights, glass stage, resize from every edge).
import { Theme, I18n } from "theme.slint";
import { Glass, GlassButton, TrafficLights } from "widgets.slint";

export component AppWin inherits Window {
    title: root.screen ? root.device + " · ZenLink" : root.app-name + " · " + root.device + " · ZenLink";
    icon: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png");
    no-frame: true;
    background: transparent;
    // A phone-like start size; the virtual display follows the window.
    preferred-width: 430px;
    preferred-height: 820px;
    min-width: 300px;
    min-height: 320px;
    default-font-family: "Segoe UI Variable Text";

    in property <string> app-name;
    in property <string> device;
    // Mirrors the phone's own screen (multi-device) instead of one app.
    in property <bool> screen;
    // "connecting" | "streaming" | "error"
    in property <string> phase: "connecting";
    in property <string> message;
    in property <bool> is-maximized;
    in property <bool> is-fullscreen;
    // Layout Rust needs to place the video: outer padding, header height, gap
    // between header and stage, and the picture inset inside the stage.
    out property <length> pad: 8px;
    out property <length> bar-h: 40px;
    out property <length> gap: 8px;
    out property <length> inset: 10px;
    out property <length> dock-h: 42px;
    callback action(string);
    callback window-action(string);
    callback retry();
    callback key-input(string, bool, bool, bool) -> bool;
    public function focus-keys() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(ev) => {
            if root.key-input(ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt) {
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        // As the main window: full screen has nothing behind the glass, so a solid theme colour.
        background: root.is-fullscreen ? (Theme.dark ? #121214 : #f2f2f7) : Theme.base;
        border-radius: root.is-maximized || root.is-fullscreen ? 0px : 12px;
        clip: true;
        VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            // Header: part of the glass window, drag it to move the window.
            Rectangle {
                height: root.bar-h;
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            root.window-action("drag");
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 22px; height: 22px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        Text {
                            text: root.screen ? root.device : root.app-name;
                            font-size: 12.5px;
                            font-weight: 650;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: root.phase == "streaming" ? (root.screen ? "Live" : root.device)
                                : root.phase == "error" ? I18n.t("Disconnected") : I18n.t("Connecting…");
                            font-size: 10.5px;
                            color: Theme.text-3;
                            overflow: elide;
                        }
                    }
                    // Back into the main window (like dropping a Chrome tab back).
                    if root.screen: GlassButton {
                        primary: true;
                        icon: "\u{E8A0}";
                        label: I18n.t("Merge");
                        tip: I18n.t("Move this phone back into the main ZenLink window");
                        clicked => { root.action("merge"); }
                    }
                    GlassButton {
                        icon: root.is-fullscreen ? "\u{E73F}" : "\u{E740}";
                        tip: root.is-fullscreen ? I18n.t("Exit full screen") : I18n.t("Full screen");
                        clicked => { root.window-action("fullscreen"); }
                    }
                    TrafficLights {
                        maximized: root.is-maximized;
                        act(a) => { root.window-action(a); }
                    }
                }
            }
            // Glass stage, as in the main window; the picture sits inside it.
            Rectangle {
                vertical-stretch: 1;
                border-radius: 22px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.edge;
                clip: true;
                if root.phase != "streaming": VerticalLayout {
                    alignment: center;
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: root.phase == "error"
                            ? (root.message != "" ? root.message : I18n.t("The app could not be opened."))
                            : (root.screen ? I18n.t("Connecting to ") + root.device + "…" : I18n.t("Opening ") + root.app-name + "…");
                        font-size: 13px;
                        color: root.phase == "error" ? Theme.warn : Theme.text-2;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    if root.phase == "error": HorizontalLayout {
                        alignment: center;
                        GlassButton { primary: true; icon: "\u{E72C}"; label: I18n.t("Try again"); clicked => { root.retry(); } }
                    }
                }
            }
            // Phone buttons under the picture: the same set as the main window's dock.
            Rectangle {
                height: root.dock-h;
                dock := Glass {
                    width: min(parent.width, row.min-width);
                    x: (parent.width - self.width) / 2;
                    height: parent.height;
                    border-radius: self.height / 2;
                    fl := Flickable {
                        content-width: max(self.width, row.min-width);
                        interactive: row.min-width > self.width;
                        row := HorizontalLayout {
                            width: fl.content-width;
                            height: dock.height;
                            padding: 4px;
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            GlassButton { icon: "\u{E72B}"; tip: I18n.t("Back"); enabled: root.phase == "streaming"; clicked => { root.action("back"); } }
                            if root.screen: GlassButton { icon: "\u{E80F}"; tip: I18n.t("Home"); enabled: root.phase == "streaming"; clicked => { root.action("home"); } }
                            if root.screen: GlassButton { icon: "\u{E8A9}"; tip: I18n.t("Recent apps"); enabled: root.phase == "streaming"; clicked => { root.action("switcher"); } }
                            if !root.screen: GlassButton { icon: "\u{E777}"; tip: I18n.t("Restart the app"); enabled: root.phase == "streaming"; clicked => { root.action("restart-app"); } }
                            Rectangle { width: 1px; background: Theme.dark ? #ffffff1f : #0000001a; }
                            GlassButton { icon: "\u{E9E9}"; tip: "Quick Settings"; enabled: root.phase == "streaming"; clicked => { root.action("quick-settings"); } }
                            GlassButton { icon: "\u{EA8F}"; tip: I18n.t("Notifications"); enabled: root.phase == "streaming"; clicked => { root.action("notifications"); } }
                            GlassButton { icon: "\u{E993}"; tip: I18n.t("Phone volume down"); enabled: root.phase == "streaming"; clicked => { root.action("vol-down"); } }
                            GlassButton { icon: "\u{E995}"; tip: I18n.t("Phone volume up"); enabled: root.phase == "streaming"; clicked => { root.action("vol-up"); } }
                            GlassButton { icon: "\u{E72E}"; tip: I18n.t("Power button (lock / wake the screen)"); enabled: root.phase == "streaming"; clicked => { root.action("lock"); } }
                        }
                    }
                }
            }
        }
    }
    // Resize from every edge and corner (no system frame).
    for e in [
        { id: "n", x: 10px, y: 0px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
        { id: "s", x: 10px, y: -5px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
        { id: "w", x: 0px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
        { id: "e", x: -5px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
        { id: "nw", x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
        { id: "se", x: -10px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
        { id: "ne", x: -10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        { id: "sw", x: 0px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
    ]: TouchArea {
        enabled: !root.is-maximized && !root.is-fullscreen;
        x: e.x < 0 ? parent.width + e.x : e.x;
        y: e.y < 0 ? parent.height + e.y : e.y;
        width: e.w < 0 ? parent.width + e.w : e.w;
        height: e.h < 0 ? parent.height + e.h : e.h;
        mouse-cursor: e.c;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.window-action("resize-" + e.id);
            }
        }
    }
}
